---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { clinic, nav } from "../data/clinic";
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="#top" aria-label="KCC Clinic, на початок сторінки" data-rec="R-U08">
      <Logo class="logo" />
    </a>

    <nav class="site-nav" aria-label="Розділи сторінки" data-rec="R-U04">
      <ul class="site-nav__list">
        {nav.map((item) => <li><a class="site-nav__link" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__actions" data-rec="R-U01">
      <a class="site-header__phone" href={clinic.tel}>{clinic.phone}</a>
      <a class="btn btn--brand site-header__call" href={clinic.tel}>Подзвонити</a>
      <a class="icon-call" href={clinic.tel} aria-label="Подзвонити в клініку">
        <Icon name="phone" size={22} />
      </a>
      <details class="menu" data-menu>
        <summary class="menu__toggle">
          <span class="menu__label menu__label--open">Меню</span>
          <span class="menu__label menu__label--close">Закрити</span>
        </summary>
        <div class="menu__panel">
          <nav aria-label="Меню сторінки">
            <ul class="menu__list">
              {nav.map((item) => <li><a class="menu__link" href={item.href}>{item.label}</a></li>)}
            </ul>
          </nav>
          <div class="menu__contact">
            <a class="menu__phone" href={clinic.tel}>{clinic.phone}</a>
            <p class="menu__address">{clinic.address}</p>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
